# Copy to .env.local for development. These values are public by design:
# they end up in the browser bundle. Never put a secret key here.

# Supabase project URL and *publishable* key (Project Settings > API Keys).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Where the FastAPI backend runs.
VITE_API_URL=http://localhost:8000

# Show "Continue with Google" only once the Google provider is set up in Supabase.
VITE_ENABLE_GOOGLE=false
