# Copy to api/.env for local development. Never commit the real file.
ENVIRONMENT=development

# Supabase project URL. Tokens are checked against its public signing keys.
SUPABASE_URL=https://your-project-ref.supabase.co

# The API's own low-privilege Postgres login (see README, "Database role").
DATABASE_URL=postgresql://prepmate_api.your-project-ref:CHANGE_ME@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Browser origins allowed to call the API, comma-separated. https only in production.
CORS_ORIGINS=http://localhost:5173

# LLM providers for STAR feedback. At least one is required for practice to work.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Fallback: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Per-user daily limits
# DAILY_FEEDBACK_LIMIT=20
# DAILY_AUDIO_SECONDS_LIMIT=600
